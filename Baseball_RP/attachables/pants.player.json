{
  "format_version": "1.20.30",
  "minecraft:attachable": {
    "description": {
      "identifier": "baseball:pants",
      "item": { "baseball:pants": "query.is_owner_identifier_any('minecraft:player')" },
      "materials": {
        "default": "armor",
        "enchanted": "armor_enchanted"
      },
      "textures": {
        "default": "textures/models/armor/baseball_pants",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.baseball.pants"
      },
      "scripts": {
        "parent_setup": "variable.leg_layer_visible = 0.0;"
      },
      "render_controllers": ["controller.render.armor"]
    }
  }
}
